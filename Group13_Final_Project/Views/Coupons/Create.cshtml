@model Group13_Final_Project.Models.Coupon

@{
    ViewData["Title"] = "Create Coupon";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-tag"></i> Create New Coupon</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CouponCode" class="form-label"></label>
                            <input asp-for="CouponCode" class="form-control" placeholder="e.g., SAVE10, FREESHIP" maxlength="20" />
                            <span asp-validation-for="CouponCode" class="text-danger"></span>
                            <small class="text-muted">1-20 alphanumeric characters only</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CouponType" class="form-label"></label>
                            <select asp-for="CouponType" class="form-select" id="couponType">
                                <option value="@CouponTypeEnum.PercentOff">Percent Off</option>
                                <option value="@CouponTypeEnum.FreeShipping">Free Shipping</option>
                            </select>
                            <span asp-validation-for="CouponType" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="percentOffSection">
                            <label asp-for="DiscountPercent" class="form-label">Discount Percentage</label>
                            <div class="input-group">
                                <input asp-for="DiscountPercent" class="form-control" type="number" min="1" max="100" step="1" placeholder="e.g., 10" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="DiscountPercent" class="text-danger"></span>
                            <small class="text-muted">Enter percentage off the total order (1-100)</small>
                        </div>

                        <div class="mb-3" id="freeShippingSection" style="display: none;">
                            <label asp-for="FreeThreshold" class="form-label">Minimum Order Amount (Optional)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="FreeThreshold" class="form-control" type="number" min="0" step="0.01" placeholder="Leave empty for all orders" />
                            </div>
                            <span asp-validation-for="FreeThreshold" class="text-danger"></span>
                            <small class="text-muted">Leave empty for free shipping on all orders, or enter minimum subtotal</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> <strong>Important:</strong> Coupons cannot be edited after creation. Please review carefully before submitting.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Create Coupon
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('couponType').addEventListener('change', function() {
            var percentSection = document.getElementById('percentOffSection');
            var shippingSection = document.getElementById('freeShippingSection');

            if (this.value === '@((int)CouponTypeEnum.PercentOff)' || this.value === 'PercentOff') {
                percentSection.style.display = 'block';
                shippingSection.style.display = 'none';
            } else {
                percentSection.style.display = 'none';
                shippingSection.style.display = 'block';
            }
        });

        // Trigger on page load
        document.getElementById('couponType').dispatchEvent(new Event('change'));
    </script>
}
