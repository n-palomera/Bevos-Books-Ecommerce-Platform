@model OrderHistoryViewModel

@{
    ViewData["Title"] = "Order History";
}

<h1>Order History</h1>
<p class="lead">View all your past orders</p>

<hr />

<!-- Filters -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Filter Orders</h5>
    </div>
    <div class="card-body">
        <form asp-action="OrderHistory" method="get">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="startDate">Start Date:</label>
                        <input type="date" name="startDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="endDate">End Date:</label>
                        <input type="date" name="endDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label for="statusFilter">Status:</label>
                        <select name="statusFilter" class="form-control">
                            <option value="">All Statuses</option>
                            <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                            <option value="Shipped" selected="@(Model.StatusFilter == "Shipped")">Shipped</option>
                            <option value="Delivered" selected="@(Model.StatusFilter == "Delivered")">Delivered</option>
                            <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>&nbsp;</label><br />
                        <button type="submit" class="btn btn-primary">Filter</button>
                        <a asp-action="OrderHistory" class="btn btn-secondary">Clear</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Orders List -->
@if (Model.Orders != null && Model.Orders.Any())
{
    <p><strong>Showing @Model.Orders.Count order(s)</strong></p>

    @foreach (var order in Model.Orders)
    {
        <div class="card mb-3">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Order #@order.OrderID</h5>
                        <small class="text-muted">Placed on @order.OrderDate.ToString("MMMM dd, yyyy")</small>
                    </div>
                    <div class="col-md-6 text-right">
                        <span class="badge badge-@(order.OrderStatus == OrderStatusEnum.Shipped ? "success" : order.OrderStatus == OrderStatusEnum.Pending ? "warning" : order.OrderStatus == OrderStatusEnum.Delivered ? "info" : "secondary") badge-lg">
                            @order.OrderStatus
                        </span>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Author</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in order.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@detail.BookID">
                                        @detail.Book.Title
                                    </a>
                                </td>
                                <td>@detail.Book.Authors</td>
                                <td>@detail.Quantity</td>
                                <td>@detail.Price.ToString("C")</td>
                                <td>@detail.LineTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="row mt-3">
                    <div class="col-md-6">
                        @if (order.Card != null)
                        {
                            <p>
                                <strong>Payment Method:</strong>
                                @order.Card.CardType
                                ****@order.Card.CardNumber.Substring(order.Card.CardNumber.Length - 4)
                            </p>
                        }
                        @if (order.Coupon != null)
                        {
                            <p class="text-success"><strong>Coupon Applied:</strong> @order.Coupon.CouponCode</p>
                        }
                    </div>
                    <div class="col-md-6 text-right">
                        <p><strong>Subtotal:</strong> @order.Subtotal.ToString("C")</p>
                        <p><strong>Shipping:</strong> @order.ShippingFee.ToString("C")</p>
                        <h5><strong>Total:</strong> @order.Total.ToString("C")</h5>
                    </div>
                </div>

                <div class="mt-2">
                    <a asp-action="Recommendations" asp-route-orderId="@order.OrderID" class="btn btn-sm btn-info">
                        View Recommendations
                    </a>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <h5>No orders found</h5>
        <p>You haven't placed any orders yet. <a asp-controller="Books" asp-action="Index">Start shopping!</a></p>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Account</a>
</div>
