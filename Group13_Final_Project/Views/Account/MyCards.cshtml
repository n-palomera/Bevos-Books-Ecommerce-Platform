@model ICollection<Card>

@{
    ViewData["Title"] = "My Cards";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-credit-card"></i> My Credit Cards</h2>
                @if (Model.Count < 3)
                {
                    <a asp-action="AddCard" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add New Card
                    </a>
                }
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="card shadow">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-credit-card-2-front" style="font-size: 4rem; color: #ccc;"></i>
                        <h4 class="mt-3 text-muted">No Credit Cards Saved</h4>
                        <p class="text-muted">Add a credit card to make checkout faster.</p>
                        <a asp-action="AddCard" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Add Your First Card
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var card in Model)
                    {
                        <div class="col-md-6 mb-4">
                            <div class="card shadow h-100">
                                <div class="card-header @(card.CardType == CardTypeEnum.Visa ? "bg-primary" :
                                                          card.CardType == CardTypeEnum.MasterCard ? "bg-danger" :
                                                          card.CardType == CardTypeEnum.AmericanExpress ? "bg-info" : "bg-warning") text-white">
                                    <i class="bi bi-credit-card"></i>
                                    @Html.DisplayFor(m => card.CardType)
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title font-monospace">
                                        @card.MaskedCardNumber
                                    </h5>
                                    <p class="card-text text-muted">
                                        Card ID: @card.CardID
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i>
                    You have @Model.Count of 3 maximum credit cards.
                    @if (Model.Count >= 3)
                    {
                        <span>To add a new card, you must first contact customer service.</span>
                    }
                </div>
            }

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Account
                </a>
            </div>
        </div>
    </div>
</div>
