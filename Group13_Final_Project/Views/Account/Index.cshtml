@model IndexViewModel

@{
    ViewData["Title"] = "My Account";
}

<div class="container">
    <h1>My Account</h1>
    <p class="lead">Welcome back, @Model.FirstName @Model.LastName!</p>

    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Account Information</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name:</dt>
                        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone:</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Address:</dt>
                        <dd class="col-sm-8">
                            @Model.Address<br />
                            @Model.City, @Model.State @Model.ZipCode
                        </dd>

                        @if (Model.Birthday.HasValue)
                        {
                            <dt class="col-sm-4">Birthday:</dt>
                            <dd class="col-sm-8">@Model.Birthday.Value.ToString("MMMM dd, yyyy")</dd>
                        }
                    </dl>

                    <div class="mt-3">
                        <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
                        <a asp-action="ChangePassword" class="btn btn-secondary">Change Password</a>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Quick Actions</h4>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a asp-action="OrderHistory" class="list-group-item list-group-item-action">
                            <i class="bi bi-clock-history"></i> View Order History
                        </a>
                        <a asp-action="MyCards" class="list-group-item list-group-item-action">
                            <i class="bi bi-credit-card"></i> Manage Credit Cards (@Model.CardCount cards)
                        </a>
                        <a asp-controller="Books" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-book"></i> Browse Books
                        </a>
                        <a asp-controller="ShoppingCart" asp-action="Index" class="list-group-item list-group-item-action">
                            <i class="bi bi-cart"></i> View Shopping Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Account Status</h5>
                </div>
                <div class="card-body">
                    <p class="text-success"><strong>✓ Account Active</strong></p>
                    <p class="text-muted">Member since registration</p>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Need Help?</h5>
                </div>
                <div class="card-body">
                    <p>If you have any questions or need assistance, please contact our support team.</p>
                    <a href="mailto:team13@bevosbooks.com" class="btn btn-sm btn-outline-primary">Contact Support</a>
                </div>
            </div>
        </div>
    </div>
</div>
