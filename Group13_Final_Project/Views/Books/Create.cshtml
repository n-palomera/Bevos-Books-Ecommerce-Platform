@model Group13_Final_Project.Models.Book

@{
    ViewData["Title"] = "Add New Book";
}

<h1>Add New Book</h1>
<p class="text-muted">Add a new book to the inventory (Admin Only)</p>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Book Information</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Book Number:</strong> @ViewBag.NextBookNumber (automatically assigned)
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label"><strong>Title</strong></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Authors" class="control-label"><strong>Authors</strong></label>
                        <input asp-for="Authors" class="form-control" placeholder="e.g., John Smith, Jane Doe" />
                        <span asp-validation-for="Authors" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="control-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="GenreID" class="control-label"><strong>Genre</strong></label>
                                <select asp-for="GenreID" class="form-control" asp-items="ViewBag.GenreID">
                                    <option value="">-- Select Genre --</option>
                                </select>
                                <span asp-validation-for="GenreID" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label class="control-label">Or Add New Genre</label>
                                <input type="text" name="newGenre" class="form-control" placeholder="Enter new genre name" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PublishDate" class="control-label"><strong>Publish Date</strong></label>
                        <input asp-for="PublishDate" class="form-control" type="date" />
                        <span asp-validation-for="PublishDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Pricing & Inventory</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Price" class="control-label"><strong>Price ($)</strong></label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="Cost" class="control-label"><strong>Cost ($)</strong></label>
                                <input asp-for="Cost" class="form-control" type="number" step="0.01" min="0" />
                                <span asp-validation-for="Cost" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="InventoryQuantity" class="control-label"><strong>Initial Inventory</strong></label>
                                <input asp-for="InventoryQuantity" class="form-control" type="number" min="0" />
                                <span asp-validation-for="InventoryQuantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="ReorderPoint" class="control-label"><strong>Reorder Point</strong></label>
                                <input asp-for="ReorderPoint" class="form-control" type="number" min="0" />
                                <small class="text-muted">Alert when inventory falls below this</small>
                                <span asp-validation-for="ReorderPoint" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary btn-lg">Add Book</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
