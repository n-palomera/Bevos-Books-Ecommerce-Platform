@model IEnumerable<Group13_Final_Project.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<h1>Find Books</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label for="searchString">Search by Title, Author, or Book Number:</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Enter search term..."/>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="genreId">Filter by Genre:</label>
                <select name="genreId" class="form-control">
                    <option value="">All Genres</option>
                    @foreach (var genre in ViewBag.Genres)
                    {
                        <option value="@genre.GenreID" selected="@(ViewData["CurrentGenre"] != null && genre.GenreID == (int)ViewData["CurrentGenre"])">@genre.GenreName</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="sortOrder">Sort By:</label>
                <select name="sortOrder" class="form-control">
                    <option value="">Title (A-Z)</option>
                    <option value="title_desc">Title (Z-A)</option>
                    <option value="author">Author (A-Z)</option>
                    <option value="author_desc">Author (Z-A)</option>
                    <option value="popular">Most Popular</option>
                    <option value="newest">Newest First</option>
                    <option value="oldest">Oldest First</option>
                    <option value="rating">Highest Rated</option>
                </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label>&nbsp;</label>
                <div class="form-check">
                    <input type="checkbox" name="inStockOnly" value="true" class="form-check-input" @(ViewData["InStockOnly"] != null && (bool)ViewData["InStockOnly"] ? "checked" : "") />
                    <label class="form-check-label">In Stock Only</label>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Show All Books</a>
        </div>
    </div>
</form>

<p><strong>@ViewBag.RecordCount</strong></p>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Book Number</th>
                <th>In Stock</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Authors</td>
                    <td>@book.BookNumber</td>
                    <td>
                        @if (book.InStock)
                        {
                            <span class="badge badge-success">In Stock</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Out of Stock</span>
                        }
                    </td>
                    <td>
                        @if (book.AverageRating > 0)
                        {
                            <span>@book.AverageRating.ToString("F1") ⭐</span>
                        }
                        else
                        {
                            <span class="text-muted">No ratings yet</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@book.BookID" class="btn btn-sm btn-info">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No books found matching your search criteria.
    </div>
}
