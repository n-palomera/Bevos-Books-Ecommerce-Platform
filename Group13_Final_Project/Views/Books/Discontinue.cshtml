@model Group13_Final_Project.Models.Book

@{
    ViewData["Title"] = "Discontinue Book";
}

<h1>Discontinue Book</h1>
<p class="text-muted">Are you sure you want to discontinue this book?</p>

<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Book Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Book Number:</dt>
                    <dd class="col-sm-8">@Model.BookNumber</dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8">@Model.Title</dd>

                    <dt class="col-sm-4">Authors:</dt>
                    <dd class="col-sm-8">@Model.Authors</dd>

                    <dt class="col-sm-4">Genre:</dt>
                    <dd class="col-sm-8">@Model.Genre?.GenreName</dd>

                    <dt class="col-sm-4">Price:</dt>
                    <dd class="col-sm-8">@String.Format("{0:C}", Model.Price)</dd>

                    <dt class="col-sm-4">Current Inventory:</dt>
                    <dd class="col-sm-8">@Model.InventoryQuantity</dd>
                </dl>
            </div>
            <div class="card-footer">
                <div class="alert alert-warning mb-3">
                    <strong>Warning:</strong> Discontinuing a book will:
                    <ul class="mb-0">
                        <li>Remove it from customer browsing</li>
                        <li>Prevent new purchases</li>
                        <li>Keep existing order history intact</li>
                    </ul>
                    This action can be reversed by reactivating the book.
                </div>

                <form asp-action="Discontinue" method="post">
                    <input type="hidden" asp-for="BookID" />
                    <button type="submit" class="btn btn-danger">Yes, Discontinue This Book</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
