@model IEnumerable<Group13_Final_Project.Models.Reorder>

@{
    ViewData["Title"] = "Receive Inventory";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-box-arrow-in-down"></i> Receive Inventory</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Order Date</th>
                                <th>Book</th>
                                <th>Author</th>
                                <th class="text-center">Ordered</th>
                                <th class="text-center">Received</th>
                                <th class="text-center">Remaining</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reorder in Model)
                            {
                                <tr>
                                    <td>@reorder.Date.ToString("MM/dd/yyyy")</td>
                                    <td><strong>@reorder.Book?.Title</strong></td>
                                    <td>@reorder.Book?.Authors</td>
                                    <td class="text-center">@reorder.Quantity</td>
                                    <td class="text-center">@reorder.QuantityReceived</td>
                                    <td class="text-center"><strong>@reorder.RemainingQuantity</strong></td>
                                    <td class="text-center">
                                        @if (reorder.ReorderStatus == Group13_Final_Project.Models.ReorderStatusEnum.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (reorder.ReorderStatus == Group13_Final_Project.Models.ReorderStatusEnum.PartiallyReceived)
                                        {
                                            <span class="badge bg-info">Partial</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="ReceiveBook" asp-route-id="@reorder.ReorderID" class="btn btn-sm btn-success">
                                            <i class="bi bi-box-arrow-in-down"></i> Receive
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No orders awaiting receipt.
        </div>
    }
</div>
