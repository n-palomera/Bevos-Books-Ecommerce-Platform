@model Group13_Final_Project.Models.Reorder

@{
    ViewData["Title"] = "Create Manual Reorder";
    var book = ViewBag.Book as Group13_Final_Project.Models.Book;
    var defaultCost = ViewBag.DefaultCost;
    var avgMargin = ViewBag.AverageProfitMargin;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-lg"></i> Create Reorder</h4>
                </div>
                <div class="card-body">
                    @if (book != null)
                    {
                        <div class="alert alert-info">
                            <h5>@book.Title</h5>
                            <p class="mb-1"><strong>Author:</strong> @book.Authors</p>
                            <p class="mb-1"><strong>Genre:</strong> @book.Genre?.GenreName</p>
                            <p class="mb-1"><strong>Current Inventory:</strong> @book.InventoryQuantity</p>
                            <p class="mb-1"><strong>Reorder Point:</strong> @book.ReorderPoint</p>
                            <p class="mb-0"><strong>Avg Profit Margin:</strong> @(((decimal)avgMargin).ToString("C"))</p>
                        </div>
                    }

                    <form asp-action="CreateManual" method="post">
                        <input type="hidden" asp-for="BookID" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label">Quantity to Order</label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cost" class="form-label">Cost per Unit</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Cost" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Cost" class="text-danger"></span>
                            <small class="text-muted">Last cost paid: @(((decimal)defaultCost).ToString("C"))</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="ManualOrder" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Place Reorder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
