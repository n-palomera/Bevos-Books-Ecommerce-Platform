@model List<Group13_Final_Project.Controllers.ReorderViewModel>

@{
    ViewData["Title"] = "Automatic Reorder";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-lightning"></i> Automatic Reorder</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>@Model.Count book(s)</strong> are below their reorder point and need restocking.
        </div>

        <form asp-action="ProcessAutomatic" method="post">
            <div class="card shadow">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Book #</th>
                                    <th>Title</th>
                                    <th>Author</th>
                                    <th>Genre</th>
                                    <th class="text-center">Current Inv</th>
                                    <th class="text-center">Reorder Pt</th>
                                    <th class="text-center">Pending</th>
                                    <th class="text-center">Qty to Order</th>
                                    <th class="text-end">Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    <input type="hidden" name="reorders[@i].BookID" value="@Model[i].BookID" />
                                    <tr>
                                        <td>@Model[i].BookNumber</td>
                                        <td><strong>@Model[i].BookTitle</strong></td>
                                        <td>@Model[i].Authors</td>
                                        <td>@Model[i].GenreName</td>
                                        <td class="text-center text-danger"><strong>@Model[i].CurrentInventory</strong></td>
                                        <td class="text-center">@Model[i].ReorderPoint</td>
                                        <td class="text-center">@Model[i].PendingQuantity</td>
                                        <td class="text-center">
                                            <input type="number" name="reorders[@i].Quantity" value="@Model[i].Quantity"
                                                   class="form-control form-control-sm text-center" style="width: 80px;" min="0" />
                                        </td>
                                        <td class="text-end">
                                            <div class="input-group input-group-sm" style="width: 100px;">
                                                <span class="input-group-text">$</span>
                                                <input type="number" name="reorders[@i].Cost" value="@Model[i].Cost"
                                                       class="form-control text-end" step="0.01" min="0.01" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-cart-plus"></i> Place All Reorders
                        </button>
                    </div>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i> All books are adequately stocked. No automatic reorders needed.
        </div>
    }
</div>
