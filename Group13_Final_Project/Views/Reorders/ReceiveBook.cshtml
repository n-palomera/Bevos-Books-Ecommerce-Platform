@model Group13_Final_Project.Models.Reorder

@{
    ViewData["Title"] = "Receive Book";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-box-arrow-in-down"></i> Receive Book</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <h5>@Model.Book?.Title</h5>
                        <p class="mb-1"><strong>Author:</strong> @Model.Book?.Authors</p>
                        <p class="mb-1"><strong>Order Date:</strong> @Model.Date.ToString("MM/dd/yyyy")</p>
                        <p class="mb-1"><strong>Quantity Ordered:</strong> @Model.Quantity</p>
                        <p class="mb-1"><strong>Already Received:</strong> @Model.QuantityReceived</p>
                        <p class="mb-0"><strong>Remaining to Receive:</strong> <span class="text-success fw-bold">@Model.RemainingQuantity</span></p>
                    </div>

                    <form asp-action="ReceiveBook" method="post">
                        <input type="hidden" name="id" value="@Model.ReorderID" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label">Quantity Received</label>
                            <input type="number" name="quantityReceived" value="@Model.RemainingQuantity"
                                   class="form-control" min="1" max="@Model.RemainingQuantity" />
                            <small class="text-muted">Maximum: @Model.RemainingQuantity</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Receive" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Confirm Receipt
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
