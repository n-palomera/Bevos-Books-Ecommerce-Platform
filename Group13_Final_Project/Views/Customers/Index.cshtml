@model IEnumerable<Group13_Final_Project.Models.AppUser>

@{
    ViewData["Title"] = "Customers";
}

<h1>All Customers</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                <label for="searchString">Search by Name or Email:</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Enter search term..."/>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>&nbsp;</label><br/>
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Show All Customers</a>
            </div>
        </div>
    </div>
</form>

<p><strong>@ViewBag.RecordCount</strong></p>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>City, State</th>
                <th>Zip Code</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.FirstName @customer.LastName</td>
                    <td>@customer.Email</td>
                    <td>@customer.PhoneNumber</td>
                    <td>@customer.City, @customer.State</td>
                    <td>@customer.ZipCode</td>
                    <td>
                        @if (customer.Status)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No customers found matching your search criteria.
    </div>
}
