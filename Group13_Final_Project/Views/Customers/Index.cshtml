@model IEnumerable<Group13_Final_Project.Models.AppUser>

@{
    ViewData["Title"] = "Manage Customers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Manage Customers</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create Customer
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header bg-light">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-5">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                           class="form-control" placeholder="Search by name or email..." />
                </div>
                <div class="col-md-3">
                    <select name="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="Active" selected="@(ViewData["CurrentStatus"]?.ToString() == "Active")">Active</option>
                        <option value="Inactive" selected="@(ViewData["CurrentStatus"]?.ToString() == "Inactive")">Disabled</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i> Search
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">@ViewBag.RecordCount</p>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Location</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr class="@(customer.Status ? "" : "table-secondary")">
                                    <td>
                                        <strong>@customer.FirstName @customer.LastName</strong>
                                    </td>
                                    <td>@customer.Email</td>
                                    <td>@customer.PhoneNumber</td>
                                    <td>@customer.City, @customer.State @customer.ZipCode</td>
                                    <td class="text-center">
                                        @if (customer.Status)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@customer.Id" method="post" class="d-inline">
                                            @if (customer.Status)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Disable Account">
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Enable Account">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No customers found matching your search criteria.
                </div>
            }
        </div>
    </div>
</div>
