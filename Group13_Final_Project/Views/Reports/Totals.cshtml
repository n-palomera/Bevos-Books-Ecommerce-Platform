@model Group13_Final_Project.Models.ViewModels.TotalsReportViewModel

@{
    ViewData["Title"] = "Totals Summary Report";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calculator"></i> Totals Summary Report</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up"></i> Business Summary</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="card bg-success text-white h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-currency-dollar display-4"></i>
                                    <h2 class="mt-2">@Model.TotalRevenue.ToString("C")</h2>
                                    <p class="mb-0">Total Revenue</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-danger text-white h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-cash-stack display-4"></i>
                                    <h2 class="mt-2">@Model.TotalCost.ToString("C")</h2>
                                    <p class="mb-0">Total Cost</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-primary text-white h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-piggy-bank display-4"></i>
                                    <h2 class="mt-2">@Model.TotalProfit.ToString("C")</h2>
                                    <p class="mb-0">Total Profit</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="card border-primary h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-cart-check display-4 text-primary"></i>
                                    <h2 class="mt-2">@Model.TotalOrders</h2>
                                    <p class="mb-0 text-muted">Total Orders</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-info h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-people display-4 text-info"></i>
                                    <h2 class="mt-2">@Model.TotalCustomers</h2>
                                    <p class="mb-0 text-muted">Unique Customers</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-success h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-book display-4 text-success"></i>
                                    <h2 class="mt-2">@Model.TotalBooksSold</h2>
                                    <p class="mb-0 text-muted">Books Sold</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (Model.TotalRevenue > 0)
                    {
                        <hr class="my-4" />
                        <div class="row">
                            <div class="col-12">
                                <h5>Profit Margin</h5>
                                @{
                                    var profitMargin = (Model.TotalProfit / Model.TotalRevenue) * 100;
                                }
                                <div class="progress" style="height: 30px;">
                                    <div class="progress-bar bg-success" role="progressbar"
                                         style="width: @profitMargin%;"
                                         aria-valuenow="@profitMargin" aria-valuemin="0" aria-valuemax="100">
                                        @profitMargin.ToString("F1")%
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
