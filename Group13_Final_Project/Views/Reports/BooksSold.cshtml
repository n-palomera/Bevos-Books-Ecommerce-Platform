@model IEnumerable<Group13_Final_Project.Models.ViewModels.BookSoldReportViewModel>

@{
    ViewData["Title"] = "Books Sold Report";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-book"></i> Books Sold Report</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h4>@ViewBag.TotalQuantity</h4>
                    <small>Books Sold</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h4>@(((decimal)ViewBag.TotalRevenue).ToString("C"))</h4>
                    <small>Total Revenue</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h4>@(((decimal)ViewBag.TotalProfit).ToString("C"))</h4>
                    <small>Total Profit</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white">
                <div class="card-body text-center">
                    <h4>@Model.Count()</h4>
                    <small>Unique Titles</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <p class="text-muted mb-3">@ViewBag.RecordCount</p>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>
                                    <a asp-action="BooksSold" asp-route-sortOrder="@ViewData["TitleSort"]" class="text-white text-decoration-none">
                                        Title <i class="bi bi-arrow-down-up"></i>
                                    </a>
                                </th>
                                <th>Author</th>
                                <th class="text-end">
                                    <a asp-action="BooksSold" asp-route-sortOrder="@ViewData["QuantitySort"]" class="text-white text-decoration-none">
                                        Qty Sold <i class="bi bi-arrow-down-up"></i>
                                    </a>
                                </th>
                                <th class="text-end">
                                    <a asp-action="BooksSold" asp-route-sortOrder="@ViewData["RevenueSort"]" class="text-white text-decoration-none">
                                        Revenue <i class="bi bi-arrow-down-up"></i>
                                    </a>
                                </th>
                                <th class="text-end">Cost</th>
                                <th class="text-end">
                                    <a asp-action="BooksSold" asp-route-sortOrder="@ViewData["ProfitSort"]" class="text-white text-decoration-none">
                                        Profit <i class="bi bi-arrow-down-up"></i>
                                    </a>
                                </th>
                                <th class="text-end">Margin</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Title</strong></td>
                                    <td>@item.Author</td>
                                    <td class="text-end">@item.QuantitySold</td>
                                    <td class="text-end">@item.Revenue.ToString("C")</td>
                                    <td class="text-end">@item.Cost.ToString("C")</td>
                                    <td class="text-end @(item.Profit >= 0 ? "text-success" : "text-danger")">
                                        @item.Profit.ToString("C")
                                    </td>
                                    <td class="text-end">@item.ProfitMargin.ToString("F1")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No book sales data available.
                </div>
            }
        </div>
    </div>
</div>
