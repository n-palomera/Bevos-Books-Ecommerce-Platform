@{
    ViewData["Title"] = "Admin Reports";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-bar-chart-line"></i> Admin Reports</h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-book text-primary"></i> Books Sold</h5>
                    <p class="card-text">View all books sold with revenue, cost, and profit margins.</p>
                    <a asp-action="BooksSold" class="btn btn-primary">View Report</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-cart text-success"></i> All Orders</h5>
                    <p class="card-text">View all orders grouped by order with status and totals.</p>
                    <a asp-action="AllOrders" class="btn btn-success">View Report</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-people text-info"></i> All Customers</h5>
                    <p class="card-text">View all customers with order counts and revenue.</p>
                    <a asp-action="AllCustomers" class="btn btn-info">View Report</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-calculator text-warning"></i> Totals Summary</h5>
                    <p class="card-text">View overall profit, cost, and revenue summary.</p>
                    <a asp-action="Totals" class="btn btn-warning">View Report</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-boxes text-secondary"></i> Current Inventory</h5>
                    <p class="card-text">View current inventory with values and reorder status.</p>
                    <a asp-action="CurrentInventory" class="btn btn-secondary">View Report</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-star text-danger"></i> Review Activity</h5>
                    <p class="card-text">View review approvals and rejections by employee.</p>
                    <a asp-action="ReviewActivity" class="btn btn-danger">View Report</a>
                </div>
            </div>
        </div>
    </div>
</div>
