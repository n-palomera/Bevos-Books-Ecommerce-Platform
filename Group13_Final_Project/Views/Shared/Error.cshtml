@model IEnumerable<String>

@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Access Denied</h4>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (String error in Model)
                            {
                                <li class="mb-2">
                                    <i class="bi bi-x-circle text-danger me-2"></i>@error
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0">You do not have permission to access this resource.</p>
                    }
                </div>
                <div class="card-footer">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="bi bi-house-fill me-1"></i>Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
