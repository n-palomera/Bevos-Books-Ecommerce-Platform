<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bevo's Books</title>
    <link href="~/lib/twitter-bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            flex: 1;
            margin-top: 20px;
            margin-bottom: 20px;
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }

        footer {
            margin-top: auto;
            padding: 20px 0;
            background-color: #f8f9fa;
            text-align: center;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                <i class="bi bi-book"></i> Bevo's Books
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Books" asp-action="Index" class="nav-link">
                            <i class="bi bi-book"></i> Books
                        </a>
                    </li>

                    @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
                    {
                        <!-- Employee/Admin can see all orders -->
                        <li class="nav-item">
                            <a asp-controller="Orders" asp-action="Index" class="nav-link">
                                <i class="bi bi-box-seam"></i> Orders
                            </a>
                        </li>
                        <!-- Employee/Admin can see all customers -->
                        <li class="nav-item">
                            <a asp-controller="Customers" asp-action="Index" class="nav-link">
                                <i class="bi bi-people"></i> Customers
                            </a>
                        </li>
                        <!-- Employee/Admin can see all cards -->
                        <li class="nav-item">
                            <a asp-controller="Cards" asp-action="Index" class="nav-link">
                                <i class="bi bi-credit-card"></i> Cards
                            </a>
                        </li>
                        <!-- Employee/Admin can see all reviews (includes My Approval History tab) -->
                        <li class="nav-item">
                            <a asp-controller="Reviews" asp-action="Index" class="nav-link">
                                <i class="bi bi-star-half"></i> Reviews
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Admin only links -->
                            <li class="nav-item">
                                <a asp-controller="Employees" asp-action="Index" class="nav-link">
                                    <i class="bi bi-person-badge"></i> Employees
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Coupons" asp-action="Index" class="nav-link">
                                    <i class="bi bi-tag"></i> Coupons
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Reorders" asp-action="Index" class="nav-link">
                                    <i class="bi bi-box-seam"></i> Reorders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Reports" asp-action="Index" class="nav-link">
                                    <i class="bi bi-bar-chart"></i> Reports
                                </a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @* Shopping Cart - visible to all users *@
                    <li class="nav-item me-2">
                        <a asp-controller="ShoppingCart" asp-action="Index" class="nav-link position-relative">
                            <i class="bi bi-cart3 fs-5"></i>
                            @{
                                var cartItemCount = Context.Session.GetCart().TotalItems;
                            }
                            @if (cartItemCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @cartItemCount
                                </span>
                            }
                        </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Customer"))
                        {
                            <!-- Customer Menu -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="customerDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> My Account
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="customerDropdown">
                                    <li>
                                        <a asp-controller="Account" asp-action="Index" class="dropdown-item">
                                            <i class="bi bi-person"></i> Account Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Account" asp-action="Edit" class="dropdown-item">
                                            <i class="bi bi-pencil"></i> Edit Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Account" asp-action="OrderHistory" class="dropdown-item">
                                            <i class="bi bi-clock-history"></i> My Order History
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Reviews" asp-action="MyReviews" class="dropdown-item">
                                            <i class="bi bi-star"></i> My Reviews
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="Account" asp-action="MyCards" class="dropdown-item">
                                            <i class="bi bi-credit-card"></i> My Cards
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-controller="ShoppingCart" asp-action="Index" class="dropdown-item">
                                            <i class="bi bi-cart"></i> Shopping Cart
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a asp-controller="Account" asp-action="ChangePassword" class="dropdown-item">
                                            <i class="bi bi-key"></i> Change Password
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
                        {
                            <!-- Employee/Admin Account Menu -->
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Index" class="nav-link">
                                    <i class="bi bi-person-circle"></i> Account
                                </a>
                            </li>
                        }

                        <!-- Logout -->
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="LogOff" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link" style="border: none;">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <!-- Not Authenticated -->
                        <li class="nav-item">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light me-2">
                                Register
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light">
                                Log in
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="mt-auto">
        <div class="container">
            <p class="text-muted">
                &copy; 2025 - Bevo's Books | Team 13 - MIS 333K Fall 2025
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="ms-3">| Welcome, @User.Identity.Name!</span>
                }
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/twitter-bootstrap/js/bootstrap.bundle.js"></script>
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
