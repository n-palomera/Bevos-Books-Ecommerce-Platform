@model Group13_Final_Project.Models.AppUser

@{
    ViewData["Title"] = "Employee Details";
    var role = ViewBag.Role as string ?? "Employee";
    var reviewsApproved = ViewBag.ReviewsApproved ?? 0;
    var reviewsRejected = ViewBag.ReviewsRejected ?? 0;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-badge"></i> Employee Profile</h5>
                </div>
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-person-circle display-1 text-secondary"></i>
                    </div>
                    <h4>@Model.FirstName @Model.LastName</h4>
                    @if (role == "Admin")
                    {
                        <span class="badge bg-danger fs-6">Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-primary fs-6">Employee</span>
                    }

                    @if (Model.Status)
                    {
                        <span class="badge bg-success fs-6 ms-2">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary fs-6 ms-2">Fired</span>
                    }
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-bar-chart"></i> Review Statistics</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h3 class="text-success">@reviewsApproved</h3>
                            <small class="text-muted">Approved</small>
                        </div>
                        <div class="col-6">
                            <h3 class="text-danger">@reviewsRejected</h3>
                            <small class="text-muted">Rejected</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Contact Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Email:</strong></div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Phone:</strong></div>
                        <div class="col-sm-8">@Model.PhoneNumber</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Address:</strong></div>
                        <div class="col-sm-8">@Model.Address</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>City, State ZIP:</strong></div>
                        <div class="col-sm-8">@Model.City, @Model.State @Model.ZipCode</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Birthday:</strong></div>
                        <div class="col-sm-8">@(Model.Birthday?.ToString("MMMM d, yyyy") ?? "Not specified")</div>
                    </div>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-gear"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>

                        @if (role == "Employee" && Model.Status)
                        {
                            <form asp-action="Promote" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-arrow-up-circle"></i> Promote to Admin
                                </button>
                            </form>
                        }
                        else if (role == "Admin" && Model.Status)
                        {
                            <form asp-action="Demote" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-secondary">
                                    <i class="bi bi-arrow-down-circle"></i> Demote to Employee
                                </button>
                            </form>
                        }

                        <form asp-action="Fire" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @if (Model.Status)
                            {
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-person-x"></i> Fire
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-person-check"></i> Rehire
                                </button>
                            }
                        </form>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
