@model IEnumerable<(Group13_Final_Project.Models.AppUser User, string Role)>

@{
    ViewData["Title"] = "Employees";
}

<h1>All Employees</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-5">
            <div class="form-group">
                <label for="searchString">Search by Name or Email:</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Enter search term..."/>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="roleFilter">Filter by Role:</label>
                <select name="roleFilter" class="form-control">
                    <option value="">All Roles</option>
                    <option value="Employee" selected="@(ViewData["CurrentRole"]?.ToString() == "Employee")">Employee</option>
                    <option value="Manager" selected="@(ViewData["CurrentRole"]?.ToString() == "Manager")">Manager</option>
                </select>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>&nbsp;</label><br/>
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Show All Employees</a>
            </div>
        </div>
    </div>
</form>

<p><strong>@ViewBag.RecordCount</strong></p>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>City, State</th>
                <th>Role</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.User.FirstName @employee.User.LastName</td>
                    <td>@employee.User.Email</td>
                    <td>@employee.User.PhoneNumber</td>
                    <td>@employee.User.City, @employee.User.State</td>
                    <td>
                        @if (employee.Role == "Manager")
                        {
                            <span class="badge badge-primary">Manager</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Employee</span>
                        }
                    </td>
                    <td>
                        @if (employee.User.Status)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Inactive</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No employees found matching your search criteria.
    </div>
}
