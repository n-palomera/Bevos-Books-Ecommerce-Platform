@model EditReviewViewModel

@{
    ViewData["Title"] = "Edit Review";
}

<h1>Edit Review</h1>
<p class="text-muted">You can edit the review text and status, but not the rating.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Review Details</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Book:</dt>
                    <dd class="col-sm-8">@Model.BookTitle</dd>

                    <dt class="col-sm-4">Author:</dt>
                    <dd class="col-sm-8">@Model.BookAuthor</dd>

                    <dt class="col-sm-4">Reviewer:</dt>
                    <dd class="col-sm-8">@Model.ReviewerName</dd>

                    <dt class="col-sm-4">Rating:</dt>
                    <dd class="col-sm-8">
                        <span class="text-warning">
                            @for (int i = 0; i < Model.Rating; i++)
                            {
                                <span>&#9733;</span>
                            }
                            @for (int i = Model.Rating; i < 5; i++)
                            {
                                <span>&#9734;</span>
                            }
                        </span>
                        (@Model.Rating/5)
                        <span class="badge bg-secondary ms-2">Cannot be changed</span>
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReviewID" />

            <div class="form-group mb-3">
                <label asp-for="ReviewText" class="control-label"></label>
                <textarea asp-for="ReviewText" class="form-control" rows="4" placeholder="Review text (max 100 characters)"></textarea>
                <span asp-validation-for="ReviewText" class="text-danger"></span>
                <small class="form-text text-muted">Character count: <span id="charCount">0</span>/100</small>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DisputeStatus" class="control-label"></label>
                <select asp-for="DisputeStatus" asp-items="Html.GetEnumSelectList<DisputeStatusEnum>()" class="form-control"></select>
                <span asp-validation-for="DisputeStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Important Notes</h5>
            </div>
            <div class="card-body">
                <ul>
                    <li><strong>Rating cannot be changed</strong> - The customer's rating must remain as they submitted it.</li>
                    <li><strong>Review text can be edited</strong> - You may modify inappropriate content while keeping the spirit of the review.</li>
                    <li><strong>Status options:</strong>
                        <ul>
                            <li><span class="badge bg-warning text-dark">Pending</span> - Awaiting review</li>
                            <li><span class="badge bg-success">Approved</span> - Visible on the website</li>
                            <li><span class="badge bg-danger">Rejected</span> - Hidden from the website</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // Character counter
        document.addEventListener('DOMContentLoaded', function() {
            const textarea = document.querySelector('textarea[name="ReviewText"]');
            const charCount = document.getElementById('charCount');

            if (textarea && charCount) {
                textarea.addEventListener('input', function() {
                    charCount.textContent = this.value.length;

                    if (this.value.length > 100) {
                        charCount.style.color = 'red';
                    } else {
                        charCount.style.color = 'inherit';
                    }
                });

                // Initial count
                charCount.textContent = textarea.value.length;
            }
        });
    </script>
}
