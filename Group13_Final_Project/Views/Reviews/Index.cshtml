@model IEnumerable<Group13_Final_Project.Models.Review>

@{
    ViewData["Title"] = "Reviews";
}

<h1>All Reviews</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-5">
            <div class="form-group">
                <label for="searchString">Search by Reviewer or Book:</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Enter search term..."/>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="statusFilter">Filter by Status:</label>
                <select name="statusFilter" class="form-control">
                    <option value="">All Statuses</option>
                    <option value="Approved" selected="@(ViewData["CurrentStatus"]?.ToString() == "Approved")">Approved</option>
                    <option value="Pending" selected="@(ViewData["CurrentStatus"]?.ToString() == "Pending")">Pending</option>
                    <option value="Rejected" selected="@(ViewData["CurrentStatus"]?.ToString() == "Rejected")">Rejected</option>
                </select>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>&nbsp;</label><br/>
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Show All Reviews</a>
            </div>
        </div>
    </div>
</form>

<p><strong>@ViewBag.RecordCount</strong></p>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Review ID</th>
                <th>Book</th>
                <th>Reviewer</th>
                <th>Rating</th>
                <th>Review Text</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var review in Model)
            {
                <tr>
                    <td>@review.ReviewID</td>
                    <td>
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@review.BookID">
                            @review.Book.Title
                        </a>
                    </td>
                    <td>@review.Reviewer.FirstName @review.Reviewer.LastName</td>
                    <td>@review.Rating / 5</td>
                    <td>
                        @if (!string.IsNullOrEmpty(review.ReviewText))
                        {
                            if (review.ReviewText.Length > 50)
                            {
                                @review.ReviewText.Substring(0, 50)
                                <text>...</text>
                            }
                            else
                            {
                                @review.ReviewText
                            }
                        }
                        else
                        {
                            <em class="text-muted">No review text</em>
                        }
                    </td>
                    <td>
                        @switch (review.DisputeStatus)
                        {
                            case Group13_Final_Project.Models.DisputeStatusEnum.Approved:
                                <span class="badge bg-success">Approved</span>
                                break;
                            case Group13_Final_Project.Models.DisputeStatusEnum.Pending:
                                <span class="badge bg-warning text-dark">Pending</span>
                                break;
                            case Group13_Final_Project.Models.DisputeStatusEnum.Rejected:
                                <span class="badge bg-danger">Rejected</span>
                                break;
                        }
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            @if (review.DisputeStatus == Group13_Final_Project.Models.DisputeStatusEnum.Pending)
                            {
                                <form asp-action="Approve" asp-route-id="@review.ReviewID" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@review.ReviewID" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Reject">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@review.ReviewID" class="btn btn-sm btn-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No reviews found matching your search criteria.
    </div>
}
