@model IEnumerable<Group13_Final_Project.Models.Card>

@{
    ViewData["Title"] = "Cards";
}

<h1>All Credit Cards</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-5">
            <div class="form-group">
                <label for="searchString">Search by Customer or Card Number:</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Enter search term..."/>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="typeFilter">Filter by Card Type:</label>
                <select name="typeFilter" class="form-control">
                    <option value="">All Types</option>
                    <option value="Visa" selected="@(ViewData["CurrentType"]?.ToString() == "Visa")">Visa</option>
                    <option value="MasterCard" selected="@(ViewData["CurrentType"]?.ToString() == "MasterCard")">MasterCard</option>
                    <option value="AmericanExpress" selected="@(ViewData["CurrentType"]?.ToString() == "AmericanExpress")">American Express</option>
                    <option value="Discover" selected="@(ViewData["CurrentType"]?.ToString() == "Discover")">Discover</option>
                </select>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>&nbsp;</label><br/>
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Show All Cards</a>
            </div>
        </div>
    </div>
</form>

<p><strong>@ViewBag.RecordCount</strong></p>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Card ID</th>
                <th>Card Type</th>
                <th>Card Number</th>
                <th>Customer</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in Model)
            {
                <tr>
                    <td>@card.CardID</td>
                    <td>
                        @switch (card.CardType)
                        {
                            case Group13_Final_Project.Models.CardTypeEnum.Visa:
                                <span class="badge badge-primary">Visa</span>
                                break;
                            case Group13_Final_Project.Models.CardTypeEnum.MasterCard:
                                <span class="badge badge-warning">MasterCard</span>
                                break;
                            case Group13_Final_Project.Models.CardTypeEnum.AmericanExpress:
                                <span class="badge badge-info">American Express</span>
                                break;
                            case Group13_Final_Project.Models.CardTypeEnum.Discover:
                                <span class="badge badge-success">Discover</span>
                                break;
                        }
                    </td>
                    <td>@card.CardNumber</td>
                    <td>@card.Customer.FirstName @card.Customer.LastName</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No cards found matching your search criteria.
    </div>
}
