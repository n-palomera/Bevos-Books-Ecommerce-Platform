@model IEnumerable<Group13_Final_Project.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Order History</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-5">
            <div class="form-group">
                <label for="searchString">Search by Customer Name or Order ID:</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Enter search term..."/>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label for="statusFilter">Filter by Status:</label>
                <select name="statusFilter" class="form-control">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(ViewData["CurrentStatus"]?.ToString() == "Pending")">Pending</option>
                    <option value="Shipped" selected="@(ViewData["CurrentStatus"]?.ToString() == "Shipped")">Shipped</option>
                    <option value="Delivered" selected="@(ViewData["CurrentStatus"]?.ToString() == "Delivered")">Delivered</option>
                    <option value="Cancelled" selected="@(ViewData["CurrentStatus"]?.ToString() == "Cancelled")">Cancelled</option>
                </select>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label>&nbsp;</label><br/>
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Show All Orders</a>
            </div>
        </div>
    </div>
</form>

<p><strong>@ViewBag.RecordCount</strong></p>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Order Date</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var orderTotal = order.OrderDetails.Sum(od => od.Quantity * od.Price) + order.ShippingFee;
                var itemCount = order.OrderDetails.Sum(od => od.Quantity);

                <tr>
                    <td>@order.OrderID</td>
                    <td>@order.Customer.FirstName @order.Customer.LastName</td>
                    <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                    <td>@itemCount @(itemCount == 1 ? "item" : "items")</td>
                    <td>@orderTotal.ToString("C")</td>
                    <td>
                        @switch (order.OrderStatus)
                        {
                            case Group13_Final_Project.Models.OrderStatusEnum.Pending:
                                <span class="badge badge-warning">Pending</span>
                                break;
                            case Group13_Final_Project.Models.OrderStatusEnum.Shipped:
                                <span class="badge badge-info">Shipped</span>
                                break;
                            case Group13_Final_Project.Models.OrderStatusEnum.Delivered:
                                <span class="badge badge-success">Delivered</span>
                                break;
                            case Group13_Final_Project.Models.OrderStatusEnum.Cancelled:
                                <span class="badge badge-danger">Cancelled</span>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.OrderID" class="btn btn-sm btn-info">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        No orders found matching your search criteria.
    </div>
}
