@model Order

@{
    ViewData["Title"] = "Ship Order";
}

<h1><i class="bi bi-truck"></i> Ship Order</h1>
<p class="lead">Confirm shipping for Order #@Model.OrderID</p>

<hr />

<div class="row">
    <div class="col-md-8">
        <div class="alert alert-warning">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Confirm Shipping</h4>
            <p>Are you sure you want to mark this order as <strong>Shipped</strong>?</p>
            <hr />
            <p class="mb-0">
                This action will update the order status and notify the customer that their order is on the way.
            </p>
        </div>

        <!-- Order Summary -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Order #@Model.OrderID</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Order Date:</dt>
                    <dd class="col-sm-8">@Model.OrderDate.ToString("MMMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Current Status:</dt>
                    <dd class="col-sm-8"><span class="badge badge-warning">@Model.OrderStatus</span></dd>

                    <dt class="col-sm-4">Customer:</dt>
                    <dd class="col-sm-8">
                        @Model.Customer.FirstName @Model.Customer.LastName<br />
                        <small class="text-muted">@Model.Customer.Email</small>
                    </dd>

                    <dt class="col-sm-4">Shipping Address:</dt>
                    <dd class="col-sm-8">
                        @Model.Customer.Address<br />
                        @Model.Customer.City, @Model.Customer.State @Model.Customer.ZipCode
                    </dd>

                    <dt class="col-sm-4">Total Items:</dt>
                    <dd class="col-sm-8">@Model.TotalItems</dd>

                    <dt class="col-sm-4">Order Total:</dt>
                    <dd class="col-sm-8"><strong>@Model.Total.ToString("C")</strong></dd>
                </dl>
            </div>
        </div>

        <!-- Items Being Shipped -->
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-box"></i> Items to Ship</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr>
                                <td>@detail.Book.Title</td>
                                <td>@detail.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Confirmation Form -->
        <form asp-action="Ship" method="post">
            <input type="hidden" asp-for="OrderID" />

            <div class="form-group">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-truck"></i> Confirm Shipping
                </button>
                <a asp-action="Details" asp-route-id="@Model.OrderID" class="btn btn-secondary btn-lg">
                    <i class="bi bi-x"></i> Cancel
                </a>
            </div>
        </form>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Shipping Info</h5>
            </div>
            <div class="card-body">
                <p><strong>What happens when you ship:</strong></p>
                <ul>
                    <li>Order status changes to "Shipped"</li>
                    <li>Customer receives notification email</li>
                    <li>Order can no longer be cancelled</li>
                    <li>Can be marked as "Delivered" later</li>
                </ul>
            </div>
        </div>
    </div>
</div>
