@model CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">
    <h2><i class="bi bi-cart3"></i> Shopping Cart</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["CartMessages"] is List<string> cartMessages && cartMessages.Any())
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong><i class="bi bi-exclamation-triangle"></i> Cart Updated:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var msg in cartMessages)
                {
                    <li>@msg</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Cart.Items.Count == 0)
    {
        <div class="card shadow">
            <div class="card-body text-center py-5">
                <i class="bi bi-cart-x" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3 text-muted">Your cart is empty</h4>
                <p class="text-muted">Browse our collection and add some books!</p>
                <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-book"></i> Browse Books
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-list-ul"></i> Cart Items (@Model.Cart.TotalItems items)</span>
                        <form asp-action="Clear" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-light" onclick="return confirm('Clear entire cart?');">
                                <i class="bi bi-trash"></i> Clear Cart
                            </button>
                        </form>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Book</th>
                                    <th class="text-center" style="width: 100px;">Price</th>
                                    <th class="text-center" style="width: 130px;">Quantity</th>
                                    <th class="text-end" style="width: 100px;">Total</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Cart.Items)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookID" class="text-decoration-none">
                                                <strong>@item.Title</strong>
                                            </a>
                                            <br />
                                            <small class="text-muted">by @item.Authors</small>
                                        </td>
                                        <td class="text-center align-middle">@item.Price.ToString("C")</td>
                                        <td class="text-center align-middle">
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center justify-content-center">
                                                <input type="hidden" name="bookId" value="@item.BookID" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="0" max="100" class="form-control form-control-sm text-center" style="width: 70px;" onchange="this.form.submit();" />
                                            </form>
                                        </td>
                                        <td class="text-end align-middle"><strong>@item.LineTotal.ToString("C")</strong></td>
                                        <td class="align-middle">
                                            <form asp-action="RemoveItem" method="post">
                                                <input type="hidden" name="bookId" value="@item.BookID" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <i class="bi bi-receipt"></i> Order Summary
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span>@Model.Cart.Subtotal.ToString("C")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping:</span>
                            <span>@Model.Shipping.ToString("C")</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Estimated Total:</strong>
                            <strong class="text-success">@Model.Total.ToString("C")</strong>
                        </div>
                        <small class="text-muted d-block mb-3">
                            <i class="bi bi-info-circle"></i> Shipping: $3.50 for first book, $1.50 each additional
                        </small>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
                        {
                            <a asp-action="Checkout" class="btn btn-success w-100 btn-lg">
                                <i class="bi bi-credit-card"></i> Proceed to Checkout
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/ShoppingCart/Checkout" class="btn btn-primary w-100 btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> Login to Checkout
                            </a>
                            <small class="text-muted d-block mt-2 text-center">
                                Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a>
                            </small>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
