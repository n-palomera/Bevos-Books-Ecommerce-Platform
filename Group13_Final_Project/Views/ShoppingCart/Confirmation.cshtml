@model OrderConfirmationViewModel

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <div class="mb-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h2 class="text-success">Thank You for Your Order!</h2>
        <p class="lead">Your order has been placed successfully.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-receipt"></i> Order Details
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <strong>Order Number:</strong>
                            <span class="badge bg-primary fs-6">#@Model.Order.OrderNumber</span>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <strong>Order Date:</strong>
                            @Model.Order.OrderDate.ToString("MMMM d, yyyy")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <strong>Status:</strong>
                            <span class="badge bg-warning text-dark">@Model.Order.OrderStatus</span>
                        </div>
                        @if (Model.Order.Card != null)
                        {
                            <div class="col-sm-6 text-sm-end">
                                <strong>Payment:</strong>
                                @Model.Order.Card.CardType - @Model.Order.Card.MaskedCardNumber
                            </div>
                        }
                    </div>

                    <hr />

                    <h6 class="mb-3">Items Ordered</h6>
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Book</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Order.OrderDetails)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookID" class="text-decoration-none">
                                            @item.Book.Title
                                        </a>
                                        <br />
                                        <small class="text-muted">by @item.Book.Authors</small>
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.Price.ToString("C")</td>
                                    <td class="text-end">@item.LineTotal.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <hr />

                    <div class="row">
                        <div class="col-md-6 offset-md-6">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <span>@Model.Order.Subtotal.ToString("C")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping:</span>
                                <span>@Model.Order.ShippingFee.ToString("C")</span>
                            </div>
                            @if (Model.Order.Coupon != null)
                            {
                                <div class="d-flex justify-content-between mb-2 text-success">
                                    <span><i class="bi bi-tag"></i> Coupon (@Model.Order.Coupon.CouponCode):</span>
                                    @if (Model.Order.Coupon.CouponType == CouponTypeEnum.PercentOff)
                                    {
                                        <span>-@Model.Order.Coupon.DiscountPercent% off</span>
                                    }
                                    else
                                    {
                                        <span>Free Shipping</span>
                                    }
                                </div>
                            }
                            <hr />
                            <div class="d-flex justify-content-between">
                                <strong>Order Total:</strong>
                                <strong class="text-success fs-5">@Model.Order.Total.ToString("C")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.RecommendedBooks.Any())
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-info text-white">
                        <i class="bi bi-lightbulb"></i> You Might Also Like
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @foreach (var book in Model.RecommendedBooks)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="text-decoration-none">
                                                    @book.Title
                                                </a>
                                            </h6>
                                            <p class="card-text">
                                                <small class="text-muted">by @book.Authors</small>
                                            </p>
                                            <p class="card-text">
                                                <strong class="text-primary">@book.Price.ToString("C")</strong>
                                                @if (book.Reviews.Any())
                                                {
                                                    <span class="ms-2">
                                                        <i class="bi bi-star-fill text-warning"></i>
                                                        @book.AverageRating.ToString("F1")
                                                    </span>
                                                }
                                            </p>
                                        </div>
                                        <div class="card-footer bg-transparent">
                                            <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                                                <input type="hidden" name="bookId" value="@book.BookID" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="text-center">
                <a asp-controller="Account" asp-action="OrderHistory" class="btn btn-outline-primary me-2">
                    <i class="bi bi-clock-history"></i> View Order History
                </a>
                <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-book"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
