@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    var appliedCouponId = Context.Session.GetInt32("AppliedCouponID");
}

<div class="container mt-4">
    <h2><i class="bi bi-credit-card"></i> Checkout</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Order Summary Column -->
        <div class="col-lg-5 order-lg-2 mb-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-receipt"></i> Order Summary
                </div>
                <div class="card-body">
                    <h6 class="mb-3">Items (@Model.Cart.TotalItems)</h6>
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <small>@item.Title</small>
                                <small class="text-muted"> x @item.Quantity</small>
                            </div>
                            <small>@item.LineTotal.ToString("C")</small>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>@Model.Cart.Subtotal.ToString("C")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        <span id="shippingDisplay">@(Model.Shipping == 0 ? "FREE" : Model.Shipping.ToString("C"))</span>
                    </div>
                    @if (appliedCouponId.HasValue)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span><i class="bi bi-tag"></i> Coupon Applied</span>
                            <form asp-action="RemoveCoupon" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-link text-danger p-0">[Remove]</button>
                            </form>
                        </div>
                        @if (Model.Discount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Discount:</span>
                                <span>-@Model.Discount.ToString("C")</span>
                            </div>
                        }
                    }
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>Total:</strong>
                        <strong class="text-success fs-5" id="totalDisplay">@Model.Total.ToString("C")</strong>
                    </div>
                </div>
            </div>

            <!-- Coupon Section -->
            <div class="card shadow mt-3">
                <div class="card-header">
                    <i class="bi bi-tag"></i> Have a Coupon?
                </div>
                <div class="card-body">
                    @if (TempData["CouponSuccess"] != null)
                    {
                        <div class="alert alert-success py-2 mb-2">
                            <i class="bi bi-check-circle"></i> @TempData["CouponSuccess"]
                        </div>
                    }
                    @if (TempData["CouponError"] != null)
                    {
                        <div class="alert alert-danger py-2 mb-2">
                            <i class="bi bi-x-circle"></i> @TempData["CouponError"]
                        </div>
                    }
                    <form asp-action="ApplyCoupon" method="post">
                        <div class="input-group">
                            <input type="text" name="couponCode" class="form-control" placeholder="Enter coupon code" maxlength="20" />
                            <button type="submit" class="btn btn-outline-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Payment Form Column -->
        <div class="col-lg-7 order-lg-1">
            <form asp-action="PlaceOrder" method="post">
                <div class="card shadow mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="bi bi-credit-card-2-front"></i> Payment Method
                    </div>
                    <div class="card-body">
                        @if (Model.SavedCards.Any())
                        {
                            <h6>Use Saved Card</h6>
                            <div class="mb-3">
                                @foreach (var card in Model.SavedCards)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="selectedCardId" id="card_@card.CardID" value="@card.CardID" />
                                        <label class="form-check-label" for="card_@card.CardID">
                                            <i class="bi bi-credit-card"></i>
                                            @card.CardType - @card.MaskedCardNumber
                                        </label>
                                    </div>
                                }
                                <div class="form-check mt-2">
                                    <input class="form-check-input" type="radio" name="selectedCardId" id="newCardOption" value="0" checked />
                                    <label class="form-check-label" for="newCardOption">
                                        <i class="bi bi-plus-circle"></i> Use a new card
                                    </label>
                                </div>
                            </div>
                            <hr />
                        }

                        <div id="newCardSection">
                            <h6>@(Model.SavedCards.Any() ? "Or Enter New Card" : "Enter Card Information")</h6>
                            <div class="mb-3">
                                <label for="newCardNumber" class="form-label">Card Number</label>
                                <input type="text" class="form-control" id="newCardNumber" name="newCardNumber"
                                       maxlength="16" pattern="\d{16}" placeholder="1234567890123456" />
                                <small class="text-muted">16 digits, no spaces or dashes</small>
                            </div>
                            <div class="mb-3">
                                <label for="newCardType" class="form-label">Card Type</label>
                                <select class="form-select" id="newCardType" name="newCardType">
                                    <option value="">Select card type...</option>
                                    <option value="Visa">Visa</option>
                                    <option value="MasterCard">MasterCard</option>
                                    <option value="AmericanExpress">American Express</option>
                                    <option value="Discover">Discover</option>
                                </select>
                            </div>
                        </div>

                        <div class="alert alert-info mb-0">
                            <i class="bi bi-shield-lock"></i>
                            <small>Your payment information is secure. The card will be saved for future purchases.</small>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-bag-check"></i> Place Order - @Model.Total.ToString("C")
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Cart
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle new card section visibility based on radio selection
        document.addEventListener('DOMContentLoaded', function() {
            const radios = document.querySelectorAll('input[name="selectedCardId"]');
            const newCardSection = document.getElementById('newCardSection');
            const newCardOption = document.getElementById('newCardOption');

            if (radios.length > 0 && newCardSection) {
                radios.forEach(radio => {
                    radio.addEventListener('change', function() {
                        if (this.value === '0' || this.id === 'newCardOption') {
                            newCardSection.style.display = 'block';
                        } else {
                            newCardSection.style.display = 'none';
                        }
                    });
                });

                // Initial state
                if (newCardOption && !newCardOption.checked) {
                    newCardSection.style.display = 'none';
                }
            }
        });
    </script>
}
