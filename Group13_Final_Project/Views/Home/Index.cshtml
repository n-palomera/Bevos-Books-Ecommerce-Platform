@using Group13_Final_Project.Models
@{
    ViewData["Title"] = "Welcome to Bevo's Books";
    var activeCoupons = ViewBag.ActiveCoupons as List<Coupon> ?? new List<Coupon>();
    var featuredBooks = ViewBag.FeaturedBooks as List<Book> ?? new List<Book>();
    var newArrivals = ViewBag.NewArrivals as List<Book> ?? new List<Book>();
}

<div class="container mt-4">
    <!-- Hero Section -->
    <div class="p-5 mb-4 bg-primary text-white rounded-3">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold"><i class="bi bi-book"></i> Welcome to Bevo's Books!</h1>
            <p class="col-md-8 fs-4">The world's not-quite-largest collection of literature. Browse our extensive catalog and find your next great read.</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-light btn-lg">
                <i class="bi bi-search"></i> Browse All Books
            </a>
        </div>
    </div>

    <!-- Active Promotions -->
    @if (activeCoupons.Any())
    {
        <div class="mb-5">
            <h3 class="mb-3"><i class="bi bi-tag-fill text-success"></i> Current Promotions</h3>
            <div class="row">
                @foreach (var coupon in activeCoupons)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card border-success h-100">
                            <div class="card-body text-center">
                                @if (coupon.CouponType == CouponTypeEnum.PercentOff)
                                {
                                    <h2 class="card-title text-success">@coupon.DiscountPercent% OFF</h2>
                                    <p class="card-text">Use code <strong class="badge bg-dark fs-5">@coupon.CouponCode</strong> at checkout</p>
                                    <small class="text-muted">Applies to your entire order</small>
                                }
                                else
                                {
                                    <h2 class="card-title text-info"><i class="bi bi-truck"></i> FREE SHIPPING</h2>
                                    <p class="card-text">Use code <strong class="badge bg-dark fs-5">@coupon.CouponCode</strong> at checkout</p>
                                    @if (coupon.FreeThreshold.HasValue)
                                    {
                                        <small class="text-muted">On orders over @coupon.FreeThreshold.Value.ToString("C")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">On all orders!</small>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Featured Books (Top Rated) -->
    @if (featuredBooks.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3><i class="bi bi-star-fill text-warning"></i> Top Rated Books</h3>
                <a asp-controller="Books" asp-action="Index" asp-route-sortOrder="rating" class="btn btn-outline-primary btn-sm">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="row">
                @foreach (var book in featuredBooks)
                {
                    <div class="col-md-4 col-lg-2 mb-3">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title">
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="text-decoration-none">
                                        @book.Title
                                    </a>
                                </h6>
                                <p class="card-text text-muted small mb-2">@book.Authors</p>
                                <p class="card-text small mb-2">
                                    <span class="badge bg-secondary">@book.Genre?.GenreName</span>
                                </p>
                                @if (book.AverageRating > 0)
                                {
                                    <p class="card-text">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        @book.AverageRating.ToString("F1")
                                    </p>
                                }
                                <p class="card-text mt-auto">
                                    <strong class="text-primary">@book.Price.ToString("C")</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- New Arrivals -->
    @if (newArrivals.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3><i class="bi bi-clock-history text-info"></i> New Arrivals</h3>
                <a asp-controller="Books" asp-action="Index" asp-route-sortOrder="newest" class="btn btn-outline-primary btn-sm">
                    View All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="row">
                @foreach (var book in newArrivals)
                {
                    <div class="col-md-4 col-lg-2 mb-3">
                        <div class="card h-100">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title">
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookID" class="text-decoration-none">
                                        @book.Title
                                    </a>
                                </h6>
                                <p class="card-text text-muted small mb-2">@book.Authors</p>
                                <p class="card-text small mb-2">
                                    <span class="badge bg-secondary">@book.Genre?.GenreName</span>
                                </p>
                                <p class="card-text small text-muted">
                                    Published: @book.PublishDate.ToString("MMM yyyy")
                                </p>
                                <p class="card-text mt-auto">
                                    <strong class="text-primary">@book.Price.ToString("C")</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Quick Links -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-search fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Browse Books</h5>
                    <p class="card-text">Search our catalog by title, author, or genre.</p>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Browse Now</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-cart-check fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Your Cart</h5>
                    <p class="card-text">View items in your shopping cart and checkout.</p>
                    <a asp-controller="ShoppingCart" asp-action="Index" class="btn btn-success">View Cart</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100">
                <div class="card-body">
                    <i class="bi bi-person-circle fs-1 text-info"></i>
                    <h5 class="card-title mt-3">My Account</h5>
                    <p class="card-text">Manage your profile, orders, and payment methods.</p>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Index" class="btn btn-info">My Account</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-info">Sign In</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
